# Copy to .env and edit per machine. PARTY_ID is the only value that
# MUST differ between the two nodes; everything else has a sane default.

# 0 = the requesting platform (needs live price + wallet data, see
#     README); 1 = the counterparty platform (contributes only its own
#     existing_debt_usd). REQUIRED, no default on purpose -- a wrong
#     value here silently runs the wrong role.
PARTY_ID=0

# The OTHER machine's reachable hostname or IP (private network address
# recommended over a public one where possible). Required for PARTY_ID=1;
# ignored (but harmless) for PARTY_ID=0, which never dials out to
# establish the MP-SPDZ connection -- it's the listener.
PEER_HOST=

# MP-SPDZ's own port range. Compose can't do arithmetic in env
# interpolation, so PORT_BASE_PLUS1 must be set explicitly if you change
# PORT_BASE away from the default -- keep it PORT_BASE+1 always (N=2).
PORT_BASE=5000
PORT_BASE_PLUS1=5001

# This node's HTTP API port.
HTTP_PORT=8000

# Must match across BOTH nodes and the compiled program's expectations --
# see Scripts/risk_data/policy.py's own POLICY_VERSION constant.
POLICY_VERSION=1
