# Copy to .env and edit per machine. PARTY_ID is the only value that
# MUST differ between nodes; everything else has a sane default.
# This template still describes a 2-machine deployment; the actual live
# deployment (see deploy/deploy_nodes.sh) runs N=3 by setting N_PLATFORMS
# explicitly per node instead of relying on this file's N=2 default --
# bump N_PLATFORMS below (and add a PARTY_ID=2 .env) to run this compose
# file as a genuine third machine too.

# How many platforms are in this deployment. Must be identical across
# every node -- see node/app/config.py.
N_PLATFORMS=2

# 0 = the requesting platform (needs live price + wallet data, see
#     README); any other value in 0..N_PLATFORMS-1 = a counterparty
#     platform (contributes only its own existing_debt_usd). REQUIRED,
#     no default on purpose -- a wrong value here silently runs the
#     wrong role.
PARTY_ID=0

# Party 0's own reachable hostname or IP (private network address
# recommended over a public one where possible). REQUIRED on BOTH
# machines, including party 0's own: MP-SPDZ's startup coordination has
# party 0 connect to this address AS A CLIENT too (to register with its
# own coordination server), and the IP it announces from that connection
# is what party 1 uses for the real data channel afterwards -- 'localhost'
# here would make party 0 announce 127.0.0.1, unreachable from the other
# machine. On party 0's machine: its own address (never 'localhost'). On
# party 1's machine: party 0's address.
PARTY0_HOST=

# MP-SPDZ's own port range. Every party listens on PORT_BASE + its own
# party id (Networking/Player.h's default_port) -- at N=2 that's just
# PORT_BASE and PORT_BASE+1. Compose can't do arithmetic in env
# interpolation, so PORT_BASE_PLUS1 must be set explicitly if you change
# PORT_BASE away from the default.
PORT_BASE=5000
PORT_BASE_PLUS1=5001

# This node's HTTP API port.
HTTP_PORT=8000

# Must match across BOTH nodes and the compiled program's expectations --
# see Scripts/risk_data/policy.py's own POLICY_VERSION constant.
POLICY_VERSION=1
